{
  "name": "akiles-travel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Akiles Travel — AI-Native marketplace for curated travel experiences in El Salvador",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json",
    "test": "tsx --test tests/concierge/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
