# Copy to .env.local and fill in to enable the real backend.
# Without these, the app runs fully on the local store (localStorage).

# Supabase (auth + database)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# AI gateway for natural-language experience extraction.
# Without a key, extraction falls back to a local heuristic parser.
# Provider can be "openai" | "anthropic" (see src/ai/extractExperience.ts).
VITE_AI_PROVIDER=
VITE_AI_API_KEY=
VITE_AI_MODEL=

# Enable after applying 0012_concierge.sql and deploying /api/concierge.
VITE_CONCIERGE_ENABLED=false
# Server-only settings; reuses existing Supabase llm_generate + Vault Gemini key.
CONCIERGE_AI_ENABLED=true
CONCIERGE_DEBUG=false
# Optional server overrides; public anon key only (no service_role required).
SUPABASE_URL=
SUPABASE_ANON_KEY=
